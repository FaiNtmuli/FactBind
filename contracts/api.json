{
  "openapi": "3.0.3",
  "info": { "title": "MidDemo API", "version": "1.0.0" },
  "x-factbind-note": "接口的 method / path / 参数 与 业务错误码的状态码，只写在这里一份。",

  "x-factbind-errors": {
    "VALIDATION_ERROR":        { "status": 400 },
    "INVALID_PARAMETER":       { "status": 400 },
    "MISSING_PARAMETER":       { "status": 400 },
    "MALFORMED_REQUEST_BODY":  { "status": 400 },
    "RESOURCE_NOT_FOUND":      { "status": 404 },
    "METHOD_NOT_ALLOWED":      { "status": 405 },
    "UNSUPPORTED_MEDIA_TYPE":  { "status": 415 },
    "DATA_INTEGRITY_VIOLATION": { "status": 409 },
    "INTERNAL_ERROR":          { "status": 500 },

    "USER_NOT_FOUND":       { "status": 404 },
    "DUPLICATE_EMAIL":      { "status": 409 },
    "USER_HAS_ORDERS":      { "status": 409 },
    "USER_NOT_ACTIVE":      { "status": 409 },
    "PRODUCT_NOT_FOUND":    { "status": 404 },
    "DUPLICATE_SKU":        { "status": 409 },
    "PRODUCT_IN_USE":       { "status": 409 },
    "PRODUCT_NOT_ON_SALE":  { "status": 409 },
    "INSUFFICIENT_STOCK":   { "status": 409 },
    "ORDER_NOT_FOUND":      { "status": 404 },
    "INVALID_ORDER_STATUS": { "status": 409 }
  },

  "paths": {
    "/api/users": {
      "get": {
        "operationId": "User.List",
        "parameters": [
          { "name": "keyword", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["ACTIVE", "DISABLED"] } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "default": 20 } }
        ]
      },
      "post": { "operationId": "User.Create" }
    },
    "/api/users/{id}": {
      "get": {
        "operationId": "User.Get",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ]
      },
      "put": {
        "operationId": "User.Update",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ]
      },
      "delete": {
        "operationId": "User.Delete",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ]
      }
    },
    "/api/users/{id}/status": {
      "patch": {
        "operationId": "User.UpdateStatus",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ]
      }
    },

    "/api/products": {
      "get": {
        "operationId": "Product.List",
        "parameters": [
          { "name": "keyword", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["ON_SALE", "OFF_SALE"] } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "default": 20 } }
        ]
      },
      "post": { "operationId": "Product.Create" }
    },
    "/api/products/{id}": {
      "get": {
        "operationId": "Product.Get",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ]
      },
      "put": {
        "operationId": "Product.Update",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ]
      },
      "delete": {
        "operationId": "Product.Delete",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ]
      }
    },
    "/api/products/{id}/stock": {
      "patch": {
        "operationId": "Product.UpdateStock",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ]
      }
    },
    "/api/products/{id}/status": {
      "patch": {
        "operationId": "Product.UpdateStatus",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ]
      }
    },

    "/api/orders": {
      "get": {
        "operationId": "Order.List",
        "parameters": [
          { "name": "userId", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["CREATED", "PAID", "CANCELLED", "COMPLETED"] } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "default": 20 } }
        ]
      },
      "post": { "operationId": "Order.Create" }
    },
    "/api/orders/{id}": {
      "get": {
        "operationId": "Order.Get",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ]
      },
      "delete": {
        "operationId": "Order.Delete",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ]
      }
    },
    "/api/orders/{id}/status": {
      "patch": {
        "operationId": "Order.UpdateStatus",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "notify", "in": "query", "required": false, "schema": { "type": "boolean", "default": false } }
        ]
      }
    },

    "/api/dashboard/summary": {
      "get": { "operationId": "Dashboard.Summary" }
    },
    "/api/dashboard/recent-orders": {
      "get": {
        "operationId": "Dashboard.RecentOrders",
        "parameters": [ { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 5 } } ]
      }
    }
  }
}
